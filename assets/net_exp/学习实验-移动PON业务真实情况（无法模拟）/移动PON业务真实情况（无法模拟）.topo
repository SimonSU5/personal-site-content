        <txttip left="675" top="168" right="989" bottom="388" content="4031 家客宽带pppoe&#x0D;&#x0A;4032 保留&#x0D;&#x0A;4033宽带电视组播&#x0D;&#x0A;4034 tr069协议 智能网关业务下发和RMS管理&#x0D;&#x0A;4035 VOIP固话&#x0D;&#x0A;4036 保留&#x0D;&#x0A;4037 保留&#x0D;&#x0A;4038保留&#x0D;&#x0A;4039互联网专线&#x0D;&#x0A;4040 云专线&#x0D;&#x0A;4041智能组网专线&#x0D;&#x0A;4042 悦享专线&#x0D;&#x0A;4043到4049到保留&#x0D;&#x0A;4050 集客纳管探针" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="675" top="408" right="830" bottom="440" content="4031 &lt;--&gt; 1001-2000&#x0D;&#x0A;4039 &lt;--&gt; 2-1000" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="84" top="358" right="307" bottom="390" content="4031 &lt;--&gt; svlan1500 cvlan209&#x0D;&#x0A;4039 &lt;--&gt; svlan300 cvlan209" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="413" top="420" right="621" bottom="437" content="4039 &lt;--&gt; svlan305 cvlan248" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="385" top="367" right="510" bottom="399" content="svlan 4031-4050&#x0D;&#x0A;admin Nbsj@13579" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="521" top="231" right="600" bottom="248" content="svlan 4050" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="340" top="217" right="495" bottom="234" content="svlan 4031，映射同理" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="120" top="223" right="283" bottom="255" content="svlan 4039&#x0D;&#x0A;实际映射为VLAN 2-1000" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="852" top="580" right="984" bottom="644" content="可以分配CVLAN&#x0D;&#x0A;ONU A：CVLAN 509&#x0D;&#x0A;ONU B：CVLAN 560&#x0D;&#x0A;CVLAN 1-4096" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="640" top="504" right="787" bottom="646" content="实际情况，&#x0D;&#x0A;模拟时S5700无法&#x0D;&#x0A;在一个口子上绑&#x0D;&#x0A;多个CVLAN，&#x0D;&#x0A;无法区分设备。&#x0D;&#x0A;实际情况下，&#x0D;&#x0A;可以通过ONUgemport&#x0D;&#x0A;来区分ONU设备，&#x0D;&#x0A;分配CVLAN。" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="59" top="411" right="312" bottom="443" content="olt命令可以直接指定stacking vlan&#x0D;&#x0A;和cus vlan，交换机无法模拟" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
    </txttips>
